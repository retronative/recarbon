---
// The Garage: ReCarbon's controls as an in-game configuration screen
// (PLAN §6). Server-rendered in full: without JS every mode's list shows and
// the device and mode switches are anchors. The script adds the switching,
// hover/focus/tap highlights, leader lines, the detail sheet and the mobile
// keyboard clusters.
import Keyboard from './Keyboard.astro';
import Controller from './Controller.astro';
import StatusBadge from '../StatusBadge.astro';
import { KEYBOARD, KEYBOARD_CLUSTERS, KEYBOARD_HEIGHT, KEYBOARD_WIDTH } from '../../data/keyboard-75';
import { BINDING, CALLOUTS, MODES, type Mode, PAD_NAMES, PAD_UNMAPPED, UI, controlsOfKey, isBindable, keyLabel, keyName } from '../../lib/controls';

const keyText = (groups: string[][]) => groups.map((g) => g.map(keyLabel).join(' + '));
const padText = (els: string[], chord?: boolean) => {
	const names = els.map((e) => PAD_NAMES[e] ?? e);
	return chord ? [names.join(' + ')] : names;
};
const keyFacts = Object.fromEntries(
	KEYBOARD.map((k) => [
		k.id,
		{
			name: keyName(k.id),
			bindable: isBindable(k.id),
			controls: controlsOfKey(k.id),
		},
	]),
);
const padFacts = Object.fromEntries(Object.entries(PAD_NAMES).map(([el, name]) => [el, { name, unmapped: PAD_UNMAPPED.includes(el) }]));
const U = 60;
// Each mode's list: the actions known (each with its status), then one group
// for the bound controls whose game action is still to verify.
const groups = (mode: Mode) => {
	const known = CALLOUTS[mode].filter((c) => c.status !== 'unverified');
	const tbd = CALLOUTS[mode].filter((c) => c.status === 'unverified');
	return [
		{ title: mode === 'settings' ? "ReCarbon's Settings keys" : 'Known actions', tbd: false, items: known },
		...(tbd.length ? [{ title: 'Bound, action to verify', tbd: true, items: tbd }] : []),
	];
};
---

<section class="garage" data-mode="driving" data-device="keyboard" aria-label="Garage: controls">
	<div class="bar">
		<div class="switch device-switch" role="group" aria-label="Device">
			<a class="sw" href="#garage-keyboard" data-set-device="keyboard" aria-pressed="true">
				<span aria-hidden="true">⌨</span> Keyboard
			</a>
			<a class="sw" href="#garage-controller" data-set-device="controller" aria-pressed="false">
				<span aria-hidden="true">🎮</span> Controller
			</a>
		</div>
		<div class="switch gearbox" role="group" aria-label="Mode">
			{
				MODES.map((m, i) => (
					<a class="gear" href={`#mode-${m.id}`} data-set-mode={m.id} aria-pressed={i === 0 ? 'true' : 'false'}>
						<span class="gear-letter" aria-hidden="true">
							{m.gear}
						</span>
						<span class="gear-label">{m.label}</span>
					</a>
				))
			}
		</div>
	</div>

	<div class="stage">
		<div class="device-pane">
			<div class="device" id="garage-keyboard" data-device-pane="keyboard">
				<div class="clusters" role="group" aria-label="Keyboard area" hidden>
					{
						KEYBOARD_CLUSTERS.map((c, i) => (
							<button
								type="button"
								class="cluster"
								data-cluster={c.id}
								data-box={c.box.map((v) => v * U).join(' ')}
								aria-pressed={i === 0 ? 'true' : 'false'}
							>
								{c.label}
							</button>
						))
					}
					<svg class="minimap" viewBox={`0 0 ${KEYBOARD_WIDTH} ${KEYBOARD_HEIGHT}`} aria-hidden="true">
						{KEYBOARD.map((k) => <rect x={k.x + 0.05} y={k.y + 0.05} width={(k.w ?? 1) - 0.1} height="0.9" rx="0.12" />)}
						<rect class="viewport" x="0" y="0" width="1" height="1" />
					</svg>
				</div>
				<Keyboard />
			</div>
			<div class="device" id="garage-controller" data-device-pane="controller">
				<Controller />
			</div>
			<p class="pad-note" data-for-device="controller">
				<StatusBadge status={BINDING.physicalController.status} />
				Physical controller: not hand-tested yet. The mapping itself is <StatusBadge status="tested" />. Back paddles
				and extra buttons: <StatusBadge status="not-mapped" />
			</p>
			<div class="detail is-empty" id="garage-detail" aria-live="polite">
				<p class="detail-empty">Hover, tap or focus a control to see its keys, its settings.toml name and how it was verified.</p>
				{MODES.flatMap((m) => CALLOUTS[m.id]).map((c) => (
					<article class="sheet" data-sheet={c.id} hidden>
						<header>
							<h3>
								{c.lines.length > 0 ? `${c.title}: ` : ''}
								<span class:list={{ tbd: c.status === 'unverified' }}>{c.action}</span>
							</h3>
							<StatusBadge status={c.status} />
						</header>
						{c.detail && <p>{c.detail}</p>}
						<p class="evidence">
							<strong>Evidence:</strong> {c.evidence}
						</p>
						{c.lines.length > 0 ? (
							<table>
								<thead>
									<tr>
										<th scope="col">Control</th>
										<th scope="col">Key 1</th>
										<th scope="col">Key 2</th>
										<th scope="col">Controller</th>
									</tr>
								</thead>
								<tbody>
									{c.lines.map((l) => (
										<tr>
											<th scope="row">
												{l.label}
												{l.action && <span class="line-act">{l.action}</span>}
											</th>
											<td>
												{l.keys[0] ? <kbd>{keyLabel(l.keys[0])}</kbd> : '–'}
												<code>
													{l.setting} = "{l.keys[0] ?? 'none'}"
												</code>
											</td>
											<td>
												{l.keys[1] ? <kbd>{keyLabel(l.keys[1])}</kbd> : '–'}
												<code>
													{l.setting2} = "{l.keys[1] ?? 'none'}"
												</code>
											</td>
											<td>{c.pad.map((p) => PAD_NAMES[p]).join(', ')}</td>
										</tr>
									))}
								</tbody>
							</table>
						) : (
							<p>
								Keyboard: {keyText(c.keyGroups).join(', ')}. Controller: {padText(c.pad, c.padChord).join(', ')}. These are
								ReCarbon's own Settings keys, not rebindable.
							</p>
						)}
						{c.lines.length > 0 && (
							<p class="binding">
								Key binding <StatusBadge status={BINDING.keyboard.status} /> · Controller mapping{' '}
								<StatusBadge status={BINDING.controller.status} /> · Physical controller{' '}
								<StatusBadge status={BINDING.physicalController.status} />
							</p>
						)}
					</article>
				))}
				<article class="sheet" data-sheet="key" hidden>
					<header>
						<h3 data-fill="title" />
					</header>
					<p data-fill="body" />
				</article>
			</div>
		</div>

		<div class="callouts">
			{
				MODES.map((m) => (
					<div class="mode-list" id={`mode-${m.id}`} data-mode-list={m.id}>
						<h3 class="mode-title">
							<span class="gear-letter" aria-hidden="true">
								{m.gear}
							</span>
							{m.label} <span class="mode-blurb">{m.blurb}</span>
						</h3>
						{groups(m.id).map((g) => (
							<section class:list={['group', { 'group--tbd': g.tbd }]} aria-label={g.title}>
								<h4 class="group-title">
									{g.title}
									{g.tbd && <StatusBadge status="unverified" />}
								</h4>
								{g.tbd && (
									<p class="group-note">
										These keys and buttons are bound to Xbox controls (that part is tested), but what each does in a race
										isn't known yet.
									</p>
								)}
								<ul>
									{g.items.map((c) => (
										<li>
											<button
												type="button"
												class:list={['callout', `is-${c.status}`]}
												data-callout={c.id}
												data-keys={c.keys.join(' ')}
												data-pad={c.pad.join(' ')}
												aria-controls="garage-detail"
												aria-pressed="false"
											>
												<span class="glyph" aria-hidden="true">
													{c.glyph}
												</span>
												<span class="what">
													<span class="act">{g.tbd ? c.title : c.action}</span>
													{!g.tbd && c.lines.length > 0 && <span class="ctl">{c.title}</span>}
												</span>
												<span class="inputs inputs--keyboard">
													{keyText(c.keyGroups).map((k) => (
														<kbd>{k}</kbd>
													))}
												</span>
												{/* A control row's own name already says which button it is. */}
												<span class="inputs inputs--controller">
													{c.lines.length === 0 &&
														padText(c.pad, c.padChord).map((p) => (
															<kbd>{p}</kbd>
														))}
												</span>
												{!g.tbd && <StatusBadge status={c.status} compact />}
											</button>
										</li>
									))}
								</ul>
							</section>
						))}
					</div>
				))
			}
		</div>
		<svg class="leaders" aria-hidden="true">
			<defs>
				<marker id="leader-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
					<path d="M 0 0 L 10 5 L 0 10 z" fill="var(--mode-color)"></path>
				</marker>
			</defs>
		</svg>
	</div>

	<p class="sr-only" data-live aria-live="polite"></p>

	<script type="application/json" data-garage-facts set:html={JSON.stringify({ keys: keyFacts, pad: padFacts, f1: UI.open.note })} />
</section>

<style>
	.garage {
		--mode-color: var(--rn-neon);
		position: relative;
		color: var(--rn-text);
	}
	.garage[data-mode='menu'] {
		--mode-color: var(--rn-volt);
	}
	.garage[data-mode='settings'] {
		--mode-color: #ff8a3d;
	}

	/* Switches: a device toggle and a gear selector. */
	.bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.25rem;
	}
	.switch {
		display: inline-flex;
		max-width: 100%;
		padding: 4px;
		gap: 4px;
		background: #0e1115;
		border: 1px solid var(--rn-graphite);
		clip-path: polygon(10px 0, 100% 0, calc(100% - 10px) 100%, 0 100%);
	}
	.sw,
	.gear {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 44px;
		padding: 0.4rem 1.1rem;
		font-family: var(--rn-font-display);
		font-weight: 700;
		font-size: 0.85rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--rn-muted);
		clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%);
		transition: color var(--rn-fast), background var(--rn-fast);
	}
	.sw:hover,
	.gear:hover {
		color: var(--rn-text);
	}
	.sw[aria-pressed='true'] {
		color: var(--rn-asphalt);
		background: var(--rn-text);
	}
	.gear[aria-pressed='true'] {
		color: var(--rn-asphalt);
		background: var(--mode-color);
	}
	@media (max-width: 30rem) {
		.bar,
		.switch {
			width: 100%;
		}
		.sw,
		.gear {
			flex: 1;
			justify-content: center;
			padding-inline: 0.5rem;
			letter-spacing: 0.04em;
		}
	}
	.gear-letter {
		display: inline-grid;
		place-items: center;
		width: 1.6rem;
		height: 1.6rem;
		font-size: 0.95rem;
		border: 1.5px solid currentColor;
		border-radius: 50%;
	}
	.sw:focus-visible,
	.gear:focus-visible,
	.callout:focus-visible,
	.cluster:focus-visible {
		outline: 2px solid var(--rn-text);
		outline-offset: 2px;
	}

	/* Stage: the device on the left, callout plates on the right. */
	.stage {
		position: relative;
		display: grid;
		gap: 1.5rem;
		grid-template-columns: minmax(0, 1fr);
	}
	@media (min-width: 64rem) {
		.stage {
			grid-template-columns: minmax(0, 1.9fr) minmax(17rem, 1fr);
			align-items: start;
		}
	}
	.device-pane {
		padding: clamp(0.75rem, 2vw, 1.5rem);
		background:
			radial-gradient(ellipse at 50% 0%, color-mix(in srgb, var(--mode-color) 10%, transparent), transparent 60%),
			linear-gradient(180deg, #12151a, #0b0d10);
		border: 1px solid var(--rn-graphite);
		clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 18px 100%, 0 calc(100% - 18px));
	}
	@media (min-width: 64rem) {
		.device-pane {
			position: sticky;
			top: calc(var(--rn-header-h) + 1rem);
			max-height: calc(100vh - var(--rn-header-h) - 2rem);
			overflow-y: auto;
			scrollbar-width: thin;
		}
		.device-pane :global(.pad) {
			max-height: 21rem;
		}
	}
	/* Below the two-column layout the drawing itself sticks under the header,
	   with the detail and the list scrolling beneath it. */
	@media (max-width: 63.99rem) {
		.device-pane {
			display: contents;
		}
		.detail.is-empty {
			display: none;
		}
		.device {
			position: sticky;
			top: var(--rn-header-h);
			z-index: 2;
			padding: 0.6rem;
			background: #0b0d10;
			border: 1px solid var(--rn-graphite);
			box-shadow: 0 10px 18px -12px #000;
		}
		.pad-note,
		.detail {
			margin-top: 0;
		}
		.callout {
			scroll-margin-top: calc(var(--rn-header-h) + var(--sticky-h, 0px) + 0.5rem);
		}
	}
	.garage.js[data-device='keyboard'] [data-for-device='controller'] {
		display: none;
	}
	.pad-note {
		margin: 1rem 0 0;
		font-size: 0.8rem;
		line-height: 2;
		color: var(--rn-muted);
	}

	.leaders {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
		overflow: visible;
	}
	.leaders :global(path.leader) {
		fill: none;
		stroke: var(--mode-color);
		stroke-width: 1.5;
		opacity: 0.9;
	}

	/* Callout plates. */
	.mode-list + .mode-list {
		margin-top: 2rem;
	}
	.mode-title {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0 0 0.75rem;
		font-family: var(--rn-font-display);
		font-size: 1rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--mode-color);
	}
	.mode-blurb {
		font-family: var(--rn-font-body);
		font-size: 0.8rem;
		letter-spacing: 0;
		text-transform: none;
		color: var(--rn-muted);
	}
	.group + .group {
		margin-top: 1.25rem;
	}
	.group-title {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin: 0 0 0.5rem;
		font-family: var(--rn-font-display);
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--rn-muted);
	}
	.group-note {
		margin: 0 0 0.5rem;
		font-size: 0.8rem;
		line-height: 1.45;
		color: var(--rn-muted);
	}
	.callouts ul {
		display: grid;
		gap: 3px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.callout {
		display: grid;
		grid-template-columns: 2.1rem minmax(0, 1fr) auto auto;
		align-items: center;
		gap: 0.6rem;
		width: 100%;
		min-height: 44px;
		padding: 0.3rem 0.6rem 0.3rem 0.4rem;
		font: inherit;
		text-align: start;
		color: inherit;
		background: #12151a;
		border: 1px solid transparent;
		border-inline-start: 3px solid var(--mode-color);
		cursor: pointer;
		transition: background var(--rn-fast), border-color var(--rn-fast), transform var(--rn-fast) var(--rn-ease);
	}
	.group--tbd .callout {
		grid-template-columns: 2.1rem minmax(0, 1fr) auto;
		background: transparent;
		border-inline-start: 3px dashed color-mix(in srgb, var(--rn-ember) 70%, transparent);
		color: #c3cad6;
	}
	.callout:hover,
	.callout.is-hot {
		background: color-mix(in srgb, var(--mode-color) 14%, #12151a);
		transform: translateX(-3px);
	}
	.callout[aria-pressed='true'] {
		background: color-mix(in srgb, var(--mode-color) 22%, #12151a);
		border-color: var(--mode-color);
	}
	.glyph {
		display: grid;
		place-items: center;
		height: 1.7rem;
		font-family: var(--rn-font-display);
		font-weight: 700;
		font-size: 0.72rem;
		color: var(--mode-color);
		border: 1px solid color-mix(in srgb, var(--mode-color) 45%, transparent);
		border-radius: 3px;
	}
	.glyph:empty {
		visibility: hidden;
	}
	.group--tbd .glyph {
		color: #c3cad6;
		border-color: #3a4250;
	}
	.what {
		display: grid;
		min-width: 0;
		line-height: 1.25;
	}
	.act {
		font-weight: 600;
		font-size: 0.92rem;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.ctl {
		font-size: 0.72rem;
		color: var(--rn-muted);
	}
	.tbd {
		font-style: italic;
		font-weight: 500;
		color: #ff9a85;
	}
	.inputs {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.25rem;
		max-width: 11rem;
	}
	kbd {
		display: inline-block;
		padding: 0 0.4rem;
		font-family: var(--rn-font-mono);
		font-size: 0.72rem;
		line-height: 1.5;
		color: var(--rn-text);
		background: #1c2129;
		border: 1px solid #3a4250;
		border-bottom-width: 2px;
		border-radius: 3px;
	}

	/* Device and mode visibility (with JS; without it everything shows). */
	.garage.js .device:not(.on) {
		display: none;
	}
	.garage.js .mode-list:not(.on) {
		display: none;
	}
	.garage.js .mode-title {
		display: none;
	}
	.garage:not(.js) .device + .device {
		margin-top: 2rem;
	}
	.garage[data-device='keyboard'] .inputs--controller,
	.garage[data-device='controller'] .inputs--keyboard {
		display: none;
	}
	.garage:not(.js) .inputs--controller {
		display: flex;
	}

	/* Mobile clusters. */
	.clusters:not([hidden]) {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr)) 4.5rem;
		gap: 0.3rem;
		align-items: center;
		margin-bottom: 0.5rem;
	}
	.cluster {
		min-height: 40px;
		padding: 0.2rem 0.3rem;
		font: 600 0.72rem/1.1 var(--rn-font-body);
		color: var(--rn-muted);
		background: #12151a;
		border: 1px solid var(--rn-graphite);
		border-radius: 3px;
		cursor: pointer;
	}
	.cluster[aria-pressed='true'] {
		color: var(--rn-asphalt);
		background: var(--mode-color);
		border-color: var(--mode-color);
	}
	.minimap {
		width: 100%;
		height: auto;
	}
	.minimap rect {
		fill: #2a303a;
	}
	.minimap .viewport {
		fill: none;
		stroke: var(--mode-color);
		stroke-width: 0.15;
	}

	/* Detail sheet. */
	.detail {
		margin-top: 1rem;
		padding: 0.85rem 1rem;
		min-height: 4rem;
		background: #0f1216;
		border: 1px solid var(--rn-graphite);
		border-top: 2px solid var(--mode-color);
	}
	.detail-empty {
		margin: 0;
		color: var(--rn-muted);
	}
	.sheet header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
	}
	.sheet h3 {
		margin: 0;
		font-family: var(--rn-font-display);
		font-size: 1.05rem;
	}
	.sheet p {
		margin: 0.6rem 0 0;
		font-size: 0.9rem;
	}
	.evidence {
		color: var(--rn-muted);
	}
	.sheet table {
		width: 100%;
		margin-top: 0.75rem;
		border-collapse: collapse;
		font-size: 0.85rem;
	}
	.sheet :is(th, td) {
		padding: 0.4rem 0.5rem;
		text-align: start;
		vertical-align: top;
		border-bottom: 1px solid var(--rn-graphite);
	}
	.sheet thead th {
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--rn-muted);
	}
	.sheet code {
		display: block;
		margin-top: 0.2rem;
		font-family: var(--rn-font-mono);
		font-size: 0.72rem;
		color: var(--rn-muted);
		overflow-wrap: anywhere;
	}
	.line-act {
		display: block;
		font-weight: 400;
		font-size: 0.8rem;
		color: var(--rn-muted);
	}
	.binding {
		line-height: 2.1;
	}
	@media (max-width: 40rem) {
		.sheet thead {
			display: none;
		}
		.sheet :is(tr, th, td) {
			display: block;
			border: 0;
			padding: 0.15rem 0;
		}
		.sheet tr {
			padding: 0.5rem 0;
			border-bottom: 1px solid var(--rn-graphite);
		}
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
	@media (prefers-reduced-motion: reduce) {
		.callout:hover,
		.callout.is-hot {
			transform: none;
		}
	}
</style>

<script>
	type Facts = {
		keys: Record<string, { name: string; bindable: boolean; controls: { label: string; setting: string; slot: number }[] }>;
		pad: Record<string, { name: string; unmapped: boolean }>;
		f1: string;
	};

	for (const root of document.querySelectorAll<HTMLElement>('.garage')) setup(root);

	function setup(root: HTMLElement) {
		root.classList.add('js');
		// Without JS the switches are anchors to each section; with it they're toggle buttons.
		for (const el of root.querySelectorAll<HTMLElement>('[data-set-mode], [data-set-device]')) {
			el.setAttribute('role', 'button');
			el.addEventListener('keydown', (e) => {
				if (e.key === ' ') {
					e.preventDefault();
					el.click();
				}
			});
		}
		const facts: Facts = JSON.parse(root.querySelector('[data-garage-facts]')!.textContent!);
		const live = root.querySelector<HTMLElement>('[data-live]')!;
		const leaders = root.querySelector<SVGSVGElement>('.leaders')!;
		const stage = root.querySelector<HTMLElement>('.stage')!;
		const kb = root.querySelector<SVGSVGElement>('.kb')!;
		const clusters = root.querySelector<HTMLElement>('.clusters')!;
		const wide = matchMedia('(min-width: 64rem)');
		// Below the two-column layout the detail sheet opens under the row that
		// was picked, and comes back to its place after.
		const detail = root.querySelector<HTMLElement>('.detail');
		const detailHome = document.createComment('detail');
		detail?.before(detailHome);
		const placeDetail = (button: HTMLElement | null) => {
			if (!detail) return;
			if (button && !wide.matches) button.closest('li')!.after(detail);
			else if (detail.previousSibling !== detailHome) detailHome.after(detail);
		};
		const stickyHeight = () => {
			const on = root.querySelector<HTMLElement>('.device.on');
			root.style.setProperty('--sticky-h', `${wide.matches || !on ? 0 : on.offsetHeight}px`);
		};
		const narrow = matchMedia('(max-width: 40rem)');
		let pinned: string | null = null;

		const $$ = <T extends Element>(sel: string) => [...root.querySelectorAll<T>(sel)];
		const callout = (id: string) => root.querySelector<HTMLButtonElement>(`[data-callout="${id}"]`);

		function setPressed(sel: string, attr: string, value: string) {
			for (const el of $$<HTMLElement>(sel)) el.setAttribute('aria-pressed', String(el.getAttribute(attr) === value));
		}

		function show() {
			const mode = root.dataset.mode!;
			const device = root.dataset.device!;
			for (const el of $$<HTMLElement>('[data-mode-list]')) el.classList.toggle('on', el.dataset.modeList === mode);
			for (const el of $$<HTMLElement>('[data-device-pane]')) el.classList.toggle('on', el.dataset.devicePane === device);
			setPressed('[data-set-mode]', 'data-set-mode', mode);
			setPressed('[data-set-device]', 'data-set-device', device);
			clusters.hidden = !(narrow.matches && device === 'keyboard');
			if (clusters.hidden) zoom(null);
			unpin();
			draw(null);
			stickyHeight();
		}

		// Light the parts of the drawing behind one callout, and draw its leaders.
		function draw(id: string | null) {
			for (const el of $$('.is-hot')) el.classList.remove('is-hot');
			leaders.querySelectorAll('path.leader').forEach((p) => p.remove());
			root.classList.toggle('has-hot', !!id);
			if (!id) return;
			const button = callout(id);
			if (!button) return;
			button.classList.add('is-hot');
			const device = root.dataset.device;
			const parts =
				device === 'keyboard'
					? button.dataset.keys!.split(' ').map((k) => kb.querySelector(`[data-key="${k}"]`))
					: button.dataset.pad!.split(' ').map((p) => root.querySelector(`.pad [data-el="${p}"]`));
			const lit = parts.filter((p): p is SVGGElement => !!p);
			for (const p of lit) p.classList.add('is-hot');
			if (!wide.matches || button.offsetParent === null) return;
			const box = stage.getBoundingClientRect();
			const b = button.getBoundingClientRect();
			// No leader to a row scrolled out of view.
			const headerBottom = document.querySelector('.hud')?.getBoundingClientRect().bottom ?? 0;
			if (b.bottom < headerBottom || b.top > innerHeight) return;
			const ex = b.left - box.left - 6;
			const ey = b.top - box.top + b.height / 2;
			for (const p of lit) {
				const r = p.getBoundingClientRect();
				if (r.width === 0) continue;
				const sx = r.left - box.left + r.width / 2;
				const sy = r.top - box.top + r.height / 2;
				const mid = sx + (ex - sx) * 0.55;
				const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
				path.setAttribute('class', 'leader');
				path.setAttribute('d', `M ${ex} ${ey} H ${mid} L ${sx} ${sy}`);
				path.setAttribute('marker-end', 'url(#leader-arrow)');
				leaders.appendChild(path);
			}
		}

		function sheet(id: string | null) {
			if (!detail) return;
			for (const s of detail.querySelectorAll<HTMLElement>('[data-sheet]')) s.hidden = s.dataset.sheet !== id;
			detail.querySelector<HTMLElement>('.detail-empty')!.hidden = !!id;
			detail.classList.toggle('is-empty', !id);
		}

		function pin(id: string) {
			pinned = id;
			setPressed('[data-callout]', 'data-callout', id);
			draw(id);
			sheet(id);
			const b = callout(id);
			placeDetail(b);
			if (b) {
				const status = b.querySelector('.badge .text')?.textContent ?? 'Action to verify';
				live.textContent = `${b.querySelector('.what')!.textContent!.replace(/\s+/g, ' ').trim()}. ${status}`;
				if (narrow.matches) zoomTo(b.dataset.keys!.split(' ')[0]);
			}
		}

		function unpin() {
			pinned = null;
			setPressed('[data-callout]', 'data-callout', '');
			sheet(null);
			placeDetail(null);
		}

		// A key or pad part with no callout in this mode: describe it.
		function describe(title: string, body: string) {
			pinned = null;
			setPressed('[data-callout]', 'data-callout', '');
			draw(null);
			placeDetail(null);
			const s = root.querySelector<HTMLElement>('[data-sheet="key"]');
			if (!s) return;
			s.querySelector('[data-fill="title"]')!.textContent = title;
			s.querySelector('[data-fill="body"]')!.textContent = body;
			sheet('key');
			live.textContent = `${title}. ${body}`;
		}

		function keyBody(id: string): string {
			const k = facts.keys[id];
			if (id === 'f1') return `Reserved: opens and closes ReCarbon's Settings, and can't be rebound. ${facts.f1}`;
			if (k.controls.length)
				return `By default: ${k.controls.map((c) => `${c.label} (${c.setting})`).join(', ')}. Not used in this mode. Rebind it in Settings > Controls.`;
			if (k.bindable) return `Not bound by default. You can bind it in Settings > Controls, or as "${id}" in the [keys] table of settings.toml.`;
			return "Not bound, and ReCarbon can't bind it (fn, Command and the media keys are left out on purpose).";
		}

		function pick(target: Element) {
			const part = target.closest<SVGGElement>('[data-callouts]');
			if (!part) return;
			const mode = root.dataset.mode!;
			const id = part.dataset.callouts!.split(' ').find((c) => c.startsWith(`${mode}-`));
			if (id) {
				pin(id);
				callout(id)?.scrollIntoView({ block: 'nearest', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
				return;
			}
			if (part.dataset.key) describe(facts.keys[part.dataset.key].name, keyBody(part.dataset.key));
			else if (part.dataset.el) {
				const p = facts.pad[part.dataset.el];
				describe(p.name, p.unmapped ? 'Not mapped: ReCarbon does not read this input (yet). If the pad remaps it to another button, it acts as that button.' : 'Mapped, but with no known action in this mode.');
			}
		}

		// Mobile: zoom the keyboard to one cluster.
		function zoom(cluster: HTMLButtonElement | null) {
			const full = kb.dataset.fullViewbox!;
			const box = cluster ? cluster.dataset.box! : full;
			kb.setAttribute('viewBox', box);
			const [, , bw, bh] = box.split(' ').map(Number);
			kb.style.aspectRatio = cluster ? `${bw} / ${bh}` : '';
			kb.style.overflow = cluster ? 'hidden' : '';
			setPressed('.cluster', 'data-cluster', cluster?.dataset.cluster ?? '');
			const vp = root.querySelector<SVGRectElement>('.minimap .viewport');
			if (vp) {
				const [x, y, w, h] = (cluster?.dataset.box ?? full).split(' ').map((v) => Number(v) / Number(kb.dataset.unit));
				vp.setAttribute('x', String(x));
				vp.setAttribute('y', String(y));
				vp.setAttribute('width', String(w));
				vp.setAttribute('height', String(h));
			}
			stickyHeight();
		}
		function zoomTo(key: string | undefined) {
			if (!key || clusters.hidden) return;
			const cap = kb.querySelector<SVGGElement>(`[data-key="${key}"] .cap`);
			if (!cap) return;
			const cx = Number(cap.getAttribute('x')) + Number(cap.getAttribute('width')) / 2;
			const cy = Number(cap.getAttribute('y')) + Number(cap.getAttribute('height')) / 2;
			const hit = $$<HTMLButtonElement>('.cluster').find((c) => {
				const [x, y, w, h] = c.dataset.box!.split(' ').map(Number);
				return cx >= x && cx <= x + w && cy >= y && cy <= y + h;
			});
			if (hit) zoom(hit);
		}

		root.addEventListener('click', (e) => {
			const t = e.target as Element;
			const dev = t.closest<HTMLElement>('[data-set-device]');
			const mode = t.closest<HTMLElement>('[data-set-mode]');
			const c = t.closest<HTMLButtonElement>('[data-callout]');
			const cl = t.closest<HTMLButtonElement>('.cluster');
			if (dev) {
				e.preventDefault();
				root.dataset.device = dev.dataset.setDevice!;
				show();
				if (!clusters.hidden) zoom(root.querySelector('.cluster'));
				live.textContent = `${dev.dataset.setDevice === 'keyboard' ? 'Keyboard' : 'Controller'} shown`;
			} else if (mode) {
				e.preventDefault();
				root.dataset.mode = mode.dataset.setMode!;
				show();
				live.textContent = `Mode: ${mode.querySelector('.gear-label')!.textContent}`;
			} else if (c) {
				if (pinned === c.dataset.callout) {
					unpin();
					draw(null);
				} else pin(c.dataset.callout!);
			} else if (cl) zoom(cl);
			else if (t.closest('.kb, .pad')) pick(t);
		});
		root.addEventListener('pointerover', (e) => {
			if (e.pointerType !== 'mouse' || pinned) return;
			const c = (e.target as Element).closest<HTMLElement>('[data-callout]');
			if (c) draw(c.dataset.callout!);
		});
		root.addEventListener('pointerout', (e) => {
			if (e.pointerType !== 'mouse' || pinned) return;
			if ((e.target as Element).closest('[data-callout]')) draw(null);
		});
		root.addEventListener('focusin', (e) => {
			const c = (e.target as Element).closest<HTMLElement>('[data-callout]');
			if (c && !pinned) draw(c.dataset.callout!);
		});
		root.addEventListener('focusout', (e) => {
			if (!pinned && (e.target as Element).closest('[data-callout]')) draw(null);
		});
		root.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && pinned) {
				unpin();
				draw(null);
			}
		});
		const redraw = () => {
			draw(pinned);
			stickyHeight();
		};
		addEventListener('resize', redraw);
		addEventListener('scroll', () => draw(pinned), { passive: true });
		narrow.addEventListener('change', show);
		wide.addEventListener('change', () => {
			placeDetail(pinned ? callout(pinned) : null);
			redraw();
		});

		show();
		if (!clusters.hidden) zoom(root.querySelector('.cluster'));
	}
</script>
