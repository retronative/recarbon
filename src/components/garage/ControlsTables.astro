---
// The controls as plain tables, per mode: the text equivalent of the Garage's
// drawings (PLAN §6), and the Controls docs page's reference.
import StatusBadge from '../StatusBadge.astro';
import { CALLOUTS, MODES, PAD_NAMES, keyLabel } from '../../lib/controls';

interface Props {
	headingLevel?: 2 | 3;
}
const H = `h${Astro.props.headingLevel ?? 3}` as 'h2' | 'h3';
const keys = (groups: string[][]) => groups.map((g) => g.map(keyLabel).join(' + ')).join(', ');
const pad = (els: string[], chord?: boolean) => els.map((e) => PAD_NAMES[e] ?? e).join(chord ? ' + ' : ', ');
---

{
	MODES.map((m) => (
		<section class="ctl-mode">
			<H id={`table-${m.id}`}>
				{m.label}: {m.blurb}
			</H>
			<div class="ctl-scroll">
				<table>
					<thead>
						<tr>
							<th scope="col">Control</th>
							<th scope="col">Keyboard (defaults)</th>
							<th scope="col">Controller</th>
							<th scope="col">Does</th>
							<th scope="col">Status</th>
						</tr>
					</thead>
					<tbody>
						{CALLOUTS[m.id].map((c) => (
							<tr>
								<th scope="row">{c.lines.length ? c.title : c.action}</th>
								<td>
									<span class="kbd-list">{keys(c.keyGroups)}</span>
									{c.lines.length > 0 && (
										<code class="toml">{c.lines
	.flatMap((l) => [`${l.setting} = "${l.keys[0] ?? 'none'}"`, ...(l.keys[1] ? [`${l.setting2} = "${l.keys[1]}"`] : [])])
	.join(', ')}</code>
									)}
								</td>
								<td>{pad(c.pad, c.padChord)}</td>
								<td>{c.lines.length ? c.action : (c.detail ?? '')}</td>
								<td>
									<StatusBadge status={c.status} />
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>
	))
}

<style>
	.ctl-scroll {
		overflow-x: auto;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.875rem;
	}
	th,
	td {
		padding: 0.5rem 0.6rem;
		text-align: start;
		vertical-align: top;
		border-bottom: 1px solid var(--sl-color-gray-5, var(--rn-graphite));
	}
	thead th {
		font-family: var(--rn-font-display);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3, var(--rn-muted));
	}
	.kbd-list {
		display: block;
		font-family: var(--rn-font-mono);
	}
	.toml {
		display: block;
		margin-top: 0.25rem;
		font-size: 0.75rem;
		color: var(--sl-color-gray-3, var(--rn-muted));
		background: none;
		padding: 0;
		overflow-wrap: anywhere;
	}
</style>
