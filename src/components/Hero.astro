---
// The landing hero (PLAN §5). Until real ReCarbon footage is approved (D8),
// the backdrop is an original illustration, labelled as one: a night city,
// canyon ridges, a wet road with oncoming headlights and distant pursuit
// lights. No gameplay, HUD or car is invented. With `site.heroVideo` set, the
// poster shows first and the muted loop is attached by JS after load, only
// when the visitor hasn't asked for reduced motion or Save-Data and isn't on
// a slow connection; it pauses offscreen and in background tabs.
// `site.trailer` (D5) adds the sound-on video in a dialog, loaded on demand.
import { site } from '../site.config';
import { url } from '../lib/url';

const video = site.heroVideo;
const trailer = site.trailer;

// The illustration's skyline and road, laid out once at build time from a
// fixed seed (the same every build).
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
const HORIZON = 520;
const VP = { x: 1060, y: HORIZON };
const buildings: { x: number; w: number; h: number }[] = [];
for (let x = -20; x < 860; ) {
	const w = 38 + Math.round(rand() * 70);
	const h = 90 + Math.round(rand() * (x < 520 ? 260 : 140));
	buildings.push({ x, w, h });
	x += w + Math.round(rand() * 6);
}
const windows = buildings.flatMap((b) => {
	const out: { x: number; y: number; c: string; o: number }[] = [];
	for (let y = HORIZON - b.h + 12; y < HORIZON - 10; y += 14)
		for (let x = b.x + 6; x < b.x + b.w - 8; x += 11)
			if (rand() < 0.22) out.push({ x, y, c: rand() < 0.75 ? '#ffd27a' : '#7cf0ff', o: 0.35 + rand() * 0.55 });
	return out;
});
// Centre-line dashes, closer together and shorter towards the horizon.
const dashes = Array.from({ length: 9 }, (_, i) => {
	const t0 = (i + 0.15) / 9;
	const t1 = (i + 0.55) / 9;
	const at = (t: number) => ({ x: VP.x + (930 - VP.x) * t * t, y: VP.y + (900 - VP.y) * t * t });
	return { a: at(t0), b: at(t1), w: 1 + 9 * t1 };
});
// Motion toward the viewer: short pieces on rays from the vanishing point,
// scaled about it (see .flow in the styles). Scaling about the VP moves a
// piece out along its ray and lengthens it, which is perspective. Each ray
// runs from the VP to E; a piece starts T0 of the way there.
const T0 = 0.035;
const along = (e: { x: number; y: number }, t: number) => ({ x: VP.x + (e.x - VP.x) * t, y: VP.y + (e.y - VP.y) * t });
const DASH_DUR = 0.95;
const flowDashes = Array.from({ length: 6 }, (_, i) => {
	const e = { x: 930, y: 900 };
	const a = along(e, T0);
	const b = along(e, T0 + 0.022);
	const len = Math.hypot(e.x - VP.x, e.y - VP.y);
	const n = { x: ((e.y - VP.y) / len) * 0.45, y: (-(e.x - VP.x) / len) * 0.45 };
	return {
		points: `${a.x - n.x},${a.y - n.y} ${a.x + n.x},${a.y + n.y} ${b.x + n.x},${b.y + n.y} ${b.x - n.x},${b.y - n.y}`,
		delay: (-(i * DASH_DUR) / 6).toFixed(2),
	};
});
// The player's headlights on the road ahead: soft pools along the car's lane,
// each smaller, flatter and dimmer the farther it is from the car (light
// spreading and falling off with distance, at the road's perspective).
const laneX = (y: number) => VP.x + (1122 - VP.x) * ((y - VP.y) / (800 - VP.y));
// Width follows the distance below the horizon (perspective); the pools
// overlap, so together they fall off smoothly rather than in bands.
const headlightPools = [710, 686, 664, 645, 628, 612, 598, 586].map((y, i) => {
	const d = y - VP.y;
	return { y, cx: laneX(y).toFixed(1), rx: (d * 0.93).toFixed(1), ry: (d * 0.21).toFixed(1), o: (0.86 ** i).toFixed(2) };
});

// Road particles: dust and small reflective details on the road and its
// shoulders, each on its own ray with its own size, brightness, duration and
// start offset, so they never reset together and the loop can't be seen.
// Each piece starts T0 of the way out; at full scale it has passed the
// bottom edge (or gone under the car, drawn on top of them).
const studs = [300, 1560].flatMap((x, side) =>
	Array.from({ length: 5 }, (_, i) => ({ x: x + (side ? 30 : -30) * rand(), r: 0.16, kind: 'stud', dur: 1.3, delay: -((i * 1.3) / 5 + rand() * 0.08) })),
);
const dust = Array.from({ length: 34 }, () => {
	const dur = 0.85 + rand() * 1.3;
	return { x: 120 + rand() * 1560, r: 0.05 + rand() * 0.08, kind: rand() < 0.2 ? 'glint' : 'dust', dur, delay: -rand() * dur };
});
const particles = [...studs, ...dust].map((p) => {
	const c = along({ x: p.x, y: 900 }, T0 + rand() * 0.01);
	return {
		cx: c.x.toFixed(2),
		cy: c.y.toFixed(2),
		r: p.r.toFixed(3),
		kind: p.kind,
		style: `--dur:${p.dur.toFixed(2)}s;--delay:${p.delay.toFixed(2)}s;--peak:${(p.kind === 'dust' ? 0.25 + rand() * 0.3 : 0.75).toFixed(2)}`,
	};
});
---

<section class="hero" aria-labelledby="hero-title" data-hero data-video={video ? JSON.stringify(video) : undefined}>
	<div class="backdrop" aria-hidden="true">
		{video && <img class="poster" src={video.poster} alt="" fetchpriority="high" decoding="async" />}
		{
			!video && (
				<svg class="scene" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMax slice">
					<defs>
						<linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0" stop-color="#04060a" />
							<stop offset="0.45" stop-color="#0b1020" />
							<stop offset="0.58" stop-color="#2a1428" />
						</linearGradient>
						<radialGradient id="city-glow" cx="0.5" cy="1" r="0.6">
							<stop offset="0" stop-color="#ff9a3d" stop-opacity="0.35" />
							<stop offset="1" stop-color="#ff9a3d" stop-opacity="0" />
						</radialGradient>
						<linearGradient id="ground" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0" stop-color="#140d16" />
							<stop offset="0.3" stop-color="#07080c" />
						</linearGradient>
						<linearGradient id="road" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0" stop-color="#151922" />
							<stop offset="1" stop-color="#06070a" />
						</linearGradient>
						<radialGradient id="lamp" r="0.5">
							<stop offset="0" stop-color="#ffffff" />
							<stop offset="0.25" stop-color="#d9f3ff" stop-opacity="0.9" />
							<stop offset="1" stop-color="#7cf0ff" stop-opacity="0" />
						</radialGradient>
						<radialGradient id="siren-red" r="0.5">
							<stop offset="0" stop-color="#ff2b3a" stop-opacity="0.9" />
							<stop offset="1" stop-color="#ff2b3a" stop-opacity="0" />
						</radialGradient>
						<radialGradient id="siren-blue" r="0.5">
							<stop offset="0" stop-color="#2b6bff" stop-opacity="0.9" />
							<stop offset="1" stop-color="#2b6bff" stop-opacity="0" />
						</radialGradient>
						<linearGradient id="trail" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0" stop-color="#ff2b3a" stop-opacity="0.55" />
							<stop offset="1" stop-color="#ff2b3a" stop-opacity="0" />
						</linearGradient>
						<radialGradient id="pool-glow" r="0.5">
							<stop offset="0" stop-color="#f4f1e6" stop-opacity="0.16" />
							<stop offset="0.55" stop-color="#f4f1e6" stop-opacity="0.07" />
							<stop offset="1" stop-color="#f4f1e6" stop-opacity="0" />
						</radialGradient>
						<linearGradient id="beam" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0" stop-color="#e9f6ff" stop-opacity="0.55" />
							<stop offset="1" stop-color="#e9f6ff" stop-opacity="0" />
						</linearGradient>
						<linearGradient id="wet" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0" stop-color="#7cf0ff" stop-opacity="0.22" />
							<stop offset="1" stop-color="#7cf0ff" stop-opacity="0" />
						</linearGradient>
						<linearGradient id="wet-amber" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0" stop-color="#ffb02e" stop-opacity="0.2" />
							<stop offset="1" stop-color="#ffb02e" stop-opacity="0" />
						</linearGradient>
					</defs>

					<rect width="1600" height="900" fill="url(#sky)" />
					<rect y={HORIZON} width="1600" height={900 - HORIZON} fill="url(#ground)" />
					<ellipse cx="380" cy={HORIZON} rx="560" ry="260" fill="url(#city-glow)" />

					{/* Canyon ridges, rim-lit by the city. */}
					<path
						class="ridge far"
						d={`M 700 ${HORIZON} L 820 410 L 905 445 L 1010 330 L 1110 390 L 1215 300 L 1330 372 L 1450 318 L 1600 360 L 1600 ${HORIZON} Z`}
					/>
					<path
						class="ridge near"
						d={`M 980 ${HORIZON} L 1120 455 L 1240 470 L 1360 400 L 1480 438 L 1600 410 L 1600 ${HORIZON} Z`}
					/>

					{/* Night city. */}
					<g class="city">
						{buildings.map((b) => (
							<rect x={b.x} y={HORIZON - b.h} width={b.w} height={b.h} />
						))}
					</g>
					<g class="windows">
						{windows.map((w) => (
							<rect x={w.x} y={w.y} width="5" height="7" fill={w.c} opacity={w.o.toFixed(2)} />
						))}
					</g>

					{/* Pursuit lights far down the road: a slow alternating glow. */}
					<g class="pursuit">
						<ellipse class="siren red" cx={VP.x - 52} cy={VP.y - 6} rx="110" ry="46" fill="url(#siren-red)" />
						<ellipse class="siren blue" cx={VP.x + 52} cy={VP.y - 6} rx="110" ry="46" fill="url(#siren-blue)" />
					</g>

					{/* The road, wet, vanishing between the city and the canyon. */}
					<path d={`M ${VP.x - 14} ${VP.y} L ${VP.x + 14} ${VP.y} L 1640 900 L 220 900 Z`} fill="url(#road)" />
					<rect x="300" y={HORIZON + 30} width="40" height="370" fill="url(#wet-amber)" transform={`skewX(-28)`} opacity="0.7" />
					<rect x="560" y={HORIZON + 20} width="26" height="380" fill="url(#wet)" transform={`skewX(-20)`} />
					<rect x="760" y={HORIZON + 10} width="18" height="390" fill="url(#wet-amber)" transform={`skewX(-10)`} />
					<path class="edge" d={`M ${VP.x - 14} ${VP.y} L 220 900 M ${VP.x + 14} ${VP.y} L 1640 900`} />
					<g class="dashes static">
						{dashes.map((d) => (
							<line x1={d.a.x} y1={d.a.y} x2={d.b.x} y2={d.b.y} stroke-width={d.w} />
						))}
					</g>

					{/* The player's headlights on the road ahead: light only, the lamps are out of view. */}
					<g class="headlights">
						{headlightPools.map((p) => (
							<ellipse cx={p.cx} cy={p.y} rx={p.rx} ry={p.ry} fill="url(#pool-glow)" opacity={p.o} />
						))}
					</g>

					{/* Forward motion: lane dashes, dust and road studs flowing out of the VP. */}
					<g class="motion">
						{flowDashes.map((d) => (
							<polygon class="flow dash" points={d.points} style={`--dur:${DASH_DUR}s;--delay:${d.delay}s`} />
						))}
						{particles.map((p) => (
							<circle class={`flow particle ${p.kind}`} cx={p.cx} cy={p.cy} r={p.r} style={p.style} />
						))}
					</g>

					{/* An oncoming car's headlights far down the road, lighting its own lane; no car is drawn. */}
					<g class="oncoming">
						<path d={`M ${VP.x - 18} ${VP.y + 18} L ${VP.x + 6} ${VP.y + 18} L 985 700 L 800 700 Z`} fill="url(#beam)" opacity="0.35" />
						<circle cx={VP.x - 11} cy={VP.y + 16} r="16" fill="url(#lamp)" />
						<circle cx={VP.x + 11} cy={VP.y + 16} r="16" fill="url(#lamp)" />
					</g>

					{/* A stylized car seen from behind, pulling away: generic shapes, no real model. */}
					<g class="car">
						<path class="trail" d="M 992 752 L 1052 752 L 1004 900 L 900 900 Z" fill="url(#trail)" />
						<path class="trail" d="M 1192 752 L 1252 752 L 1352 900 L 1248 900 Z" fill="url(#trail)" />
						<ellipse cx="1122" cy="802" rx="170" ry="14" fill="#000" opacity="0.55" />
						<rect x="988" y="782" width="46" height="20" rx="4" fill="#050608" />
						<rect x="1210" y="782" width="46" height="20" rx="4" fill="#050608" />
						<path
							class="body"
							d="M 976 788 L 980 748 Q 984 732 1004 728 L 1046 722 Q 1066 692 1096 686 L 1148 686 Q 1178 692 1198 722 L 1240 728 Q 1260 732 1264 748 L 1268 788 Q 1268 798 1258 798 L 986 798 Q 976 798 976 788 Z"
						/>
						<path class="glass" d="M 1066 720 Q 1080 698 1100 694 L 1144 694 Q 1164 698 1178 720 Z" />
						<rect class="wing" x="994" y="711" width="256" height="6" rx="3" />
						<rect x="1036" y="716" width="5" height="10" fill="#0b0d12" />
						<rect x="1203" y="716" width="5" height="10" fill="#0b0d12" />
						<ellipse cx="1022" cy="748" rx="70" ry="26" fill="url(#siren-red)" opacity="0.7" />
						<ellipse cx="1222" cy="748" rx="70" ry="26" fill="url(#siren-red)" opacity="0.7" />
						<rect class="tail" x="990" y="744" width="64" height="8" rx="4" />
						<rect class="tail" x="1190" y="744" width="64" height="8" rx="4" />
						<rect x="1084" y="758" width="76" height="16" rx="2" fill="#0b0d12" stroke="#2a303a" />
					</g>
				</svg>
			)
		}
		<div class="scrim"></div>
		<div class="hud-frame">
			<span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
		</div>
	</div>

	<div class="content wrap">
		<p class="chips">
			<span class="chip chip--fan">Unofficial fan port</span>
			<span class="chip">{site.org}</span>
		</p>
		<h1 id="hero-title" class="title">
			<span class="wordmark display"><span class="re">Re</span>Carbon</span>
			<span class="sr-only">: an unofficial native port of </span>
			<span class="game">Need for Speed: Carbon</span>
		</h1>
		<p class="platform">The Xbox 360 game, running natively on Apple Silicon Macs.</p>
		<p class="status"><span class="dot" aria-hidden="true"></span>Early development — playable in parts, not released.</p>
		<div class="ctas">
			{
				site.downloadUrl ? (
					<>
						<a class="btn" href={site.downloadUrl}>Download</a>
						<a class="btn btn--ghost" href={url('docs/installation/')}>Get started</a>
					</>
				) : (
					<>
						<a class="btn" href={url('docs/installation/')}>Get started</a>
						<p class="soon">
							<span class="soon-label">Download</span> Coming soon
						</p>
					</>
				)
			}
			{
				trailer && (
					<button class="btn btn--ghost" type="button" data-trailer-open>
						▶ Watch trailer
					</button>
				)
			}
		</div>
		<ul class="reqs" aria-label="Requirements">
			<li>
				<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="2"></rect><path d="M9 1v4M15 1v4M9 19v4M15 19v4M1 9h4M1 15h4M19 9h4M19 15h4"></path></svg>
				Apple Silicon Mac
			</li>
			<li>
				<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
				macOS 27 or newer
			</li>
			<li>
				<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="2.5"></circle></svg>
				Your own Xbox 360 disc
			</li>
		</ul>
	</div>

	<p class="caption">{video ? video.caption : 'Illustration — not gameplay'}</p>

	<button class="motion-toggle" type="button" data-motion-toggle aria-pressed="false" aria-label="Pause background animation">
		<span aria-hidden="true" class="ico-pause">❚❚</span><span aria-hidden="true" class="ico-play">▶</span>
	</button>

	{
		trailer && (
			<dialog class="trailer" data-trailer aria-label="Trailer">
				<form method="dialog">
					<button class="btn btn--ghost close" aria-label="Close trailer">
						✕
					</button>
				</form>
				<video controls preload="none" playsinline data-src={trailer.src} data-type={trailer.type}>
					{trailer.captions && <track kind="captions" src={trailer.captions} srclang="en" label="English" default />}
				</video>
			</dialog>
		)
	}
</section>

<style>
	.hero {
		position: relative;
		display: grid;
		align-items: center;
		min-height: min(92vh, 56rem);
		min-height: min(92svh, 56rem);
		overflow: hidden;
		isolation: isolate;
		background: #05070b;
	}
	.backdrop,
	.backdrop > * {
		position: absolute;
		inset: 0;
	}
	.backdrop {
		z-index: -1;
	}
	.poster,
	.backdrop :global(video),
	.scene {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* The illustration. */
	.ridge.far {
		fill: #0d0f18;
		stroke: rgb(255 120 70 / 0.35);
		stroke-width: 2;
	}
	.ridge.near {
		fill: #090b11;
		stroke: rgb(255 120 70 / 0.2);
		stroke-width: 1.5;
	}
	.city rect {
		fill: #080a10;
	}
	.edge {
		stroke: rgb(233 238 245 / 0.35);
		stroke-width: 3;
		fill: none;
	}
	.dashes line {
		stroke: rgb(255 210 122 / 0.75);
		stroke-linecap: butt;
	}
	.siren {
		mix-blend-mode: screen;
		animation: siren 3.2s ease-in-out infinite;
	}
	.siren.blue {
		animation-delay: -1.6s;
	}
	@keyframes siren {
		0%,
		100% {
			opacity: 0.15;
		}
		50% {
			opacity: 0.85;
		}
	}
	.oncoming {
		transform-box: view-box;
		transform-origin: 1060px 536px;
		animation: approach 7s cubic-bezier(0.5, 0, 0.9, 0.6) infinite;
	}
	@keyframes approach {
		0% {
			transform: scale(0.6);
			opacity: 0;
		}
		20% {
			opacity: 1;
		}
		90% {
			opacity: 1;
		}
		100% {
			transform: scale(1.35);
			opacity: 0;
		}
	}

	.car .body {
		fill: #0b0d13;
		stroke: rgb(124 240 255 / 0.35);
		stroke-width: 1.5;
	}
	.car .glass {
		fill: #141a26;
		stroke: rgb(124 240 255 / 0.25);
	}
	.car .wing {
		fill: #0b0d13;
		stroke: rgb(124 240 255 / 0.3);
	}
	.car .tail {
		fill: #ff4757;
	}
	.trail {
		animation: trail 2.4s ease-in-out infinite alternate;
	}
	@keyframes trail {
		from {
			opacity: 0.55;
		}
		to {
			opacity: 1;
		}
	}

	/* Perspective flow: scale about the vanishing point on a 1/distance
	   curve, so pieces creep out of the horizon and rush past at the edges. */
	.flow {
		transform-box: view-box;
		transform-origin: 1060px 520px;
		opacity: 0;
		animation: approach-flow var(--dur) linear var(--delay) infinite;
		will-change: transform, opacity;
	}
	.dash {
		fill: rgb(255 210 122 / 0.8);
		--peak: 0.85;
	}
	.particle.dust {
		fill: #b9c1cd;
	}
	.particle.glint {
		fill: #f4f1e6;
	}
	.particle.stud {
		fill: #ffd27a;
	}
	.headlights {
		mix-blend-mode: screen;
		pointer-events: none;
	}
	/* Fewer particles on a phone: lighter, and the hero is mostly text there. */
	@media (max-width: 40rem) {
		.particle:nth-of-type(3n) {
			display: none;
		}
	}
	@keyframes approach-flow {
		0% {
			transform: scale(1);
			opacity: 0;
		}
		20% {
			transform: scale(1.24);
			opacity: var(--peak);
		}
		45% {
			transform: scale(1.77);
		}
		70% {
			transform: scale(3.07);
		}
		85% {
			transform: scale(5.5);
			opacity: var(--peak);
		}
		94% {
			transform: scale(11.8);
		}
		100% {
			transform: scale(27);
			opacity: 0;
		}
	}
	/* The motion replaces the painted dashes; with reduced motion, those stay. */
	.dashes.static {
		display: none;
	}
	.scrim {
		/* keeps the text ≥ 4.5:1 over any frame, footage included */
		background:
			linear-gradient(90deg, rgb(5 7 11 / 0.94) 0%, rgb(5 7 11 / 0.78) 40%, rgb(5 7 11 / 0.1) 75%, transparent 100%),
			linear-gradient(0deg, var(--rn-asphalt) 0%, transparent 25%);
	}
	@media (max-width: 52rem) {
		.scrim {
			background: linear-gradient(180deg, rgb(5 7 11 / 0.55) 0%, rgb(5 7 11 / 0.85) 45%, var(--rn-asphalt) 100%);
		}
	}
	.hud-frame {
		inset: clamp(0.75rem, 3vw, 2rem);
		pointer-events: none;
	}
	.corner {
		position: absolute;
		width: 28px;
