	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin: 1.25rem 0 0;
		padding: 0.45rem 0.9rem;
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--rn-text);
		background: rgb(255 176 46 / 0.12);
		border: 1px solid rgb(255 176 46 / 0.55);
