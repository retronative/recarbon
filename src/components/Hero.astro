		border: 1px solid rgb(233 238 245 / 0.35);
		background: rgb(11 13 16 / 0.6);
	}
	.chip--fan {
		color: var(--rn-asphalt);
		background: var(--rn-amber);
		border-color: var(--rn-amber);
