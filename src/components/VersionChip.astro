---
import { site } from '../site.config';
import { url } from '../lib/url';
---

<a class="version-chip" href={url('docs/known-issues/')} title="Documentation version">
	<span aria-hidden="true">v</span>{site.docsVersion}
</a>

<style>
	.version-chip {
		display: inline-flex;
		align-items: center;
		padding: 0.15rem 0.55rem;
		font-family: var(--rn-font-mono);
		font-size: 0.75rem;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--rn-asphalt);
		background: var(--rn-amber);
		clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%);
		padding-inline: 0.8rem;
		white-space: nowrap;
	}
</style>
