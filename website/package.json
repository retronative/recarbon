{
  "name": "recarbon-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "gen:controls": "node scripts/gen-controls.mjs",
    "check:controls": "node scripts/gen-controls.mjs --check",
    "gen:progress": "node scripts/gen-progress.mjs",
    "check:progress": "node scripts/gen-progress.mjs --check",
    "check": "astro check",
    "prebuild": "npm run check:controls && npm run check:progress",
    "build": "astro build",
    "build:pages": "SITE_URL=https://retronative.github.io BASE_PATH=/recarbon/ npm run build",
    "preview": "node scripts/preview.mjs",
    "preview:pages": "BASE_PATH=/recarbon/ node scripts/preview.mjs",
    "astro": "astro",
    "check:urls": "node scripts/check-urls.mjs",
    "test:a11y": "node scripts/a11y.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.5",
    "@astrojs/starlight": "0.42.6",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.4.2",
    "sharp": "0.35.5"
  },
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "axe-core": "4.14.0",
    "playwright-core": "1.64.1",
    "typescript": "6.0.3"
  }
}
