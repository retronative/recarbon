---
// The docs header as the race HUD bar: logo, the site's links, search.
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SiteNav from '../SiteNav.astro';
import VersionChip from '../VersionChip.astro';
---

<div class="hud">
	<div class="title-wrapper">
		<SiteTitle />
		<VersionChip />
	</div>
	<div class="search print:hidden">
		<Search />
	</div>
	<nav aria-label="Site" class="main-nav">
		<SiteNav />
	</nav>
</div>

<style>
	.hud {
		display: flex;
		align-items: center;
		gap: 1rem;
		height: 100%;
	}
	.title-wrapper {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
		overflow: clip;
		padding: 0.25rem;
		margin: -0.25rem;
	}
	/* Logo and wordmark sized as on the custom pages (RaceLayout's .brand). */
	.title-wrapper :global(.site-title) {
		gap: 0.6rem;
	}
	.title-wrapper :global(.site-title img) {
		width: 48px;
		height: 30px;
	}
	.title-wrapper :global(.site-title span) {
		font-family: var(--rn-font-display);
		font-style: italic;
		font-weight: 700;
		font-size: 1.25rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--sl-color-white);
	}
	.main-nav {
		display: none;
	}
	@media (max-width: 30rem) {
		.title-wrapper :global(.version-chip) {
			display: none;
		}
	}
	.search {
		margin-inline-start: auto;
	}
	/* From 50rem the mobile menu (and its nav) is gone, so the nav shows here:
	   title left; search, then the links, on the right. */
	@media (min-width: 50rem) {
		.main-nav {
			display: block;
		}
	}
	@media (min-width: 50rem) and (max-width: 72rem) {
		.title-wrapper :global(.version-chip) {
			display: none;
		}
		/* Hidden visually only: it is the logo link's name. */
		.title-wrapper :global(.site-title span) {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0 0 0 0);
			white-space: nowrap;
		}
		.main-nav :global(a) {
			padding-inline: 0.5rem;
		}
	}
</style>
