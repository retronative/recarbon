---
// The docs header as the race HUD bar: logo, the site's links, search.
import Search from '@astrojs/starlight/components/Search.astro';
import Brand from '../Brand.astro';
import SiteNav from '../SiteNav.astro';
import ByOrg from '../ByOrg.astro';
---

<div class="hud">
	<div class="title-wrapper">
		<Brand />
		<ByOrg />
	</div>
	<div class="search print:hidden">
		<Search />
	</div>
	<nav aria-label="Site" class="main-nav">
		<SiteNav />
	</nav>
</div>

<style>
	.hud {
		display: flex;
		align-items: center;
		gap: 1rem;
		height: 100%;
	}
	.title-wrapper {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
		overflow: clip;
		padding: 0.25rem;
		margin: -0.25rem;
	}
	.main-nav {
		display: none;
	}
	.search {
		margin-inline-start: auto;
	}
	/* From 50rem the mobile menu (and its nav) is gone, so the nav shows here:
	   title left; search, then the links, on the right. */
	@media (min-width: 50rem) {
		.main-nav {
			display: block;
		}
	}
	/* Where the search and the links leave no room for it: the footer credits RetroNative. */
	@media (min-width: 50rem) and (max-width: 64rem) {
		.title-wrapper :global(.by-org) {
			display: none;
		}
	}
	@media (min-width: 50rem) and (max-width: 72rem) {
		.main-nav :global(a) {
			padding-inline: 0.5rem;
		}
	}
</style>
