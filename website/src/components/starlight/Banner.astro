---
// Every docs page carries the version banner until the first tagged release
// (then starlight-versions takes over: docs/RELEASING.md). A page's own
// `banner` frontmatter is shown instead when it has one.
import { site } from '../../site.config';
import { url } from '../../lib/url';
const { banner } = Astro.locals.starlightRoute.entry.data;
---

<div class="sl-banner" data-pagefind-ignore>
	{
		banner ? (
			<Fragment set:html={banner.content} />
		) : (
			<>
				<strong>ReCarbon v{site.docsVersion}</strong> is the latest release: these pages
				describe it. <a href={url('docs/known-issues/')}>Known issues</a>
			</>
		)
	}
</div>

<style>
	.sl-banner {
		padding: 0.5rem var(--sl-nav-pad-x);
		font-size: var(--sl-text-sm);
		text-align: center;
		text-wrap: balance;
		color: var(--rn-text);
		background: var(--rn-weave), var(--rn-red-low);
		border-bottom: 1px solid color-mix(in srgb, var(--rn-red) 60%, transparent);
	}
	.sl-banner strong {
		color: var(--rn-white);
	}
	.sl-banner a {
		color: var(--rn-red-high);
		font-weight: 600;
	}
</style>
