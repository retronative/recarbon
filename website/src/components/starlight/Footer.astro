---
import Default from '@astrojs/starlight/components/Footer.astro';
import Disclaimer from '../Disclaimer.astro';
import RepoLinks from '../RepoLinks.astro';
import OrgCredit from '../OrgCredit.astro';
---

<Default />
<div class="legal">
	<RepoLinks />
	<OrgCredit />
	<Disclaimer />
</div>

<style>
	.legal {
		margin-top: 2rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--sl-color-gray-5);
		display: grid;
		gap: 1rem;
	}
</style>
