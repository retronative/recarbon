---
// The controller guide as a list, for phones: the drawing alone is too small
// to carry its labels there. One list per mode; CSS shows the current one.
import { MODES } from '../../lib/controls';
import { READING_ORDER, label, markFor } from '../../lib/pad-guide';

const lists = MODES.map((m) => ({
	mode: m.id,
	rows: READING_ORDER.map((slot) => ({ slot, l: label(m.id, slot) })).filter((r) => r.l),
}));
---

<div class="pad-guide-list" data-for-device="controller">
	{
		lists.map((list) => (
			<ul data-for-mode={list.mode} aria-label="Controller actions in this mode">
				{list.rows.map(({ slot, l }) => (
					<li>
						<span class="chip">
							<span class="xb">{slot.chip[0]}</span>
							<span class="ps">{slot.chip[1]}</span>
						</span>
						<span class:list={['act', { tbd: l!.main.status === 'unverified' }]}>
							{l!.main.text}
							{markFor(list.mode)(l!.main.status) && (
								<span class="mark" aria-hidden="true">
									{markFor(list.mode)(l!.main.status)}
								</span>
							)}
							{l!.subs.length > 0 && <span class="subs">{l!.subs.join(' · ')}</span>}
						</span>
					</li>
				))}
			</ul>
		))
	}
</div>

<style>
	.pad-guide-list {
		display: none;
	}
	/* Xbox names by default; PlayStation-style ones when chosen. */
	.ps {
		display: none;
	}
	:global([data-labels='ps']) .ps {
		display: inline;
	}
	:global([data-labels='ps']) .xb {
		display: none;
	}
	@media (max-width: 40rem) {
		.pad-guide-list {
			display: block;
			padding: 0.6rem 0.75rem;
			background: var(--surface-2);
			border: 1px solid var(--line);
		}
		:global(.garage.js[data-device='keyboard']) .pad-guide-list {
			display: none;
		}
	}
	ul {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.45rem 0.9rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	:global([data-mode='driving']) ul:not([data-for-mode='driving']),
	:global([data-mode='menu']) ul:not([data-for-mode='menu']),
	:global([data-mode='settings']) ul:not([data-for-mode='settings']) {
		display: none;
	}
	li {
		display: flex;
		align-items: flex-start;
		gap: 0.45rem;
		min-width: 0;
		font-size: 0.85rem;
		line-height: 1.3;
	}
	.chip {
		flex: none;
		min-width: 1.6rem;
		padding: 0.05rem 0.3rem;
		font: 700 0.72rem/1.4 var(--rn-font-display);
		text-align: center;
		color: var(--text);
		background: var(--kbd-bg);
		border: 1px solid var(--line-strong);
		border-radius: 3px;
	}
	.act {
		min-width: 0;
		font-weight: 600;
		color: var(--text);
	}
	.act.tbd {
		font-weight: 500;
		font-style: italic;
		color: var(--text-muted);
	}
	.mark {
		margin-inline-start: 0.25rem;
		font-size: 0.7rem;
		color: var(--ink-amber);
	}
	.subs {
		display: block;
		font-size: 0.72rem;
		font-weight: 400;
		font-style: normal;
		color: var(--text-muted);
	}
</style>
