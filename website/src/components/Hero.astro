---
// The landing hero (PLAN §5): ReCarbon's wordmark artwork (the night canyon road
// and the city; no gameplay, HUD or car), labelled as artwork, above the copy.
// With `site.heroVideo` set, its poster shows behind the artwork first and the
// muted loop is attached by JS after load, only when the visitor hasn't asked for
// reduced motion or Save-Data and isn't on a slow connection; it pauses offscreen
// and in background tabs, and a button pauses it. `site.trailer` (D5) adds the
// sound-on video in a dialog, loaded on demand.
import { site } from '../site.config';
import { url } from '../lib/url';

const video = site.heroVideo;
const trailer = site.trailer;

// The artwork (public/brand/), 2.4:1: AVIF, with a JPEG fallback.
const art = (w: number, ext: string) => `${url(`brand/recarbon-hero-${w}.${ext}`)} ${w}w`;
const artSizes = '(min-width: 100rem) 96rem, 100vw';
---

<section class="hero" aria-labelledby="hero-title" data-hero data-video={video ? JSON.stringify(video) : undefined}>
	<div class="backdrop" aria-hidden="true">
		{video && <img class="poster" src={video.poster} alt="" fetchpriority="high" decoding="async" />}
		<div class="speed"></div>
	</div>

	<h1 id="hero-title" class="title">
		<picture class="art">
			<source type="image/avif" srcset={[art(768, 'avif'), art(1152, 'avif'), art(1536, 'avif')].join(', ')} sizes={artSizes} />
			<img
				src={url('brand/recarbon-hero-1536.jpg')}
				srcset={[art(768, 'jpg'), art(1536, 'jpg')].join(', ')}
				sizes={artSizes}
				width="1536"
				height="640"
				alt={site.name}
				fetchpriority="high"
				decoding="async"
			/>
		</picture>
		<span class="sr-only">: an unofficial native port of </span>
		<span class="wrap game-line"><span class="game">Need for Speed: Carbon</span></span>
	</h1>

	<div class="content wrap">
		<p class="chips">
			<span class="chip chip--fan">Unofficial fan port</span>
			<span class="chip">{site.org}</span>
		</p>
		<p class="platform">The Xbox 360 game, running natively on Apple Silicon Macs.</p>
		<p class="status"><span class="dot" aria-hidden="true"></span>v0.1.1: smoother movies and keyboard fixes for the first playable release.</p>
		<div class="ctas">
			{
				site.downloadUrl ? (
					<>
						<a class="btn" href={url(site.downloadUrl)}>Download for Apple Silicon</a>
						<a class="btn btn--ghost" href={url('docs/installation/')}>Get started</a>
					</>
				) : (
					<>
						<a class="btn" href={url('docs/installation/')}>Get started</a>
						<p class="soon">
							<span class="soon-label">No download</span> <a href={url('docs/developers/')}>Build from source</a>
						</p>
					</>
				)
			}
			{
				trailer && (
					<button class="btn btn--ghost" type="button" data-trailer-open>
						▶ Watch trailer
					</button>
				)
			}
		</div>
		<ul class="reqs" aria-label="Requirements">
			<li>
				<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="2"></rect><path d="M9 1v4M15 1v4M9 19v4M15 19v4M1 9h4M1 15h4M19 9h4M19 15h4"></path></svg>
				Apple Silicon Mac
			</li>
			<li>
				<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="4" width="20" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
				macOS 27 or newer
			</li>
			<li>
				<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="2.5"></circle></svg>
				Your own Xbox 360 disc
			</li>
		</ul>
	</div>

	<p class="caption">{video ? video.caption : 'Logo artwork — not gameplay'}</p>

	{
		video && (
			<button class="motion-toggle" type="button" data-motion-toggle aria-pressed="false" aria-label="Pause background video">
				<span aria-hidden="true" class="ico-pause">❚❚</span>
				<span aria-hidden="true" class="ico-play">▶</span>
			</button>
		)
	}

	{
		trailer && (
			<dialog class="trailer" data-trailer aria-label="Trailer">
				<form method="dialog">
					<button class="btn btn--ghost close" aria-label="Close trailer">
						✕
					</button>
				</form>
				<video controls preload="none" playsinline data-src={trailer.src} data-type={trailer.type}>
					{trailer.captions && <track kind="captions" src={trailer.captions} srclang="en" label="English" default />}
				</video>
			</dialog>
		)
	}
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		padding-block: clamp(0.5rem, 2vw, 1.5rem) clamp(4.5rem, 8vw, 6rem);
		text-align: center;
		background:
			radial-gradient(70% 55% at 50% 30%, rgb(40 62 102 / 0.32), transparent 70%),
			radial-gradient(60% 35% at 50% 100%, rgb(225 6 0 / 0.16), transparent 70%),
			var(--rn-black);
	}
	.backdrop,
	.backdrop > * {
		position: absolute;
		inset: 0;
	}
	.backdrop {
		z-index: -1;
	}
	.poster,
	.backdrop :global(video) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.35;
	}
	/* Speed lines: faint, static streaks at the edges. */
	.speed {
		background:
			repeating-linear-gradient(-18deg, transparent 0 22px, rgb(255 255 255 / 0.035) 22px 23px, transparent 23px 61px),
			repeating-linear-gradient(-18deg, transparent 0 140px, rgb(225 6 0 / 0.08) 140px 142px);
		mask-image: linear-gradient(90deg, #000, transparent 30%, transparent 70%, #000);
	}

	.title {
		display: grid;
		justify-items: center;
		margin: 0;
	}
	/* The artwork, whole, as wide as the screen allows (never taller than 54% of it),
	   its edges fading into the page. */
	.art {
		display: block;
		width: min(100%, 96rem, calc(54svh * 2.4));
	}
	.art img {
		display: block;
		width: 100%;
		height: auto;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent), linear-gradient(180deg, #000 78%, transparent);
		-webkit-mask-composite: source-in;
		mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent), linear-gradient(180deg, #000 78%, transparent);
		mask-composite: intersect;
	}
	/* The game's name in the site's own type: upright, plain, no logo treatment. */
	.game-line {
		display: block;
		margin-top: clamp(-4rem, -5vw, -0.5rem);
	}
	.game {
		display: inline-block;
		padding-bottom: 0.4rem;
		font-family: var(--rn-font-display);
		font-weight: 700;
		font-size: var(--rn-fs-hero);
		line-height: 1.1;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--rn-text);
		text-shadow: 0 2px 12px rgb(0 0 0 / 0.9);
		border-bottom: 3px solid var(--rn-red);
	}

	/* Copy. */
	.content {
		position: relative;
		display: grid;
		justify-items: center;
		padding-top: 1.25rem;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin: 0;
	}
	.chip {
		padding: 0.2rem 0.85rem;
		font-family: var(--rn-font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--rn-text);
		border: 1px solid rgb(230 232 236 / 0.35);
		background: rgb(10 10 12 / 0.6);
		clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%);
	}
	.chip--fan {
		color: var(--rn-white);
		background: var(--rn-red);
		border-color: var(--rn-red);
		font-weight: 700;
	}
	.platform {
		margin: 1rem 0 0;
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		color: var(--rn-silver);
	}
	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		margin: 1.1rem 0 0;
		padding: 0.45rem 1rem;
		font-weight: 600;
		font-size: 0.95rem;
		text-align: start;
		color: var(--rn-text);
		background: var(--rn-weave), var(--rn-carbon);
		border: 1px solid var(--rn-steel);
		border-inline-start: 3px solid var(--rn-red);
	}
	.dot {
		flex: none;
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: var(--rn-red-high);
		box-shadow: 0 0 10px var(--rn-red);
	}
	.ctas {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}
	.soon {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		min-height: 48px;
		margin: 0;
		padding: 0 1.2rem;
		font-family: var(--rn-font-display);
		font-weight: 700;
		font-size: 0.95rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--rn-silver);
		border: 1px dashed rgb(230 232 236 / 0.4);
		clip-path: var(--rn-clip-slant);
	}
	.soon-label {
		color: var(--rn-muted);
	}
	.soon-label::after {
		content: ' ·';
	}
	.soon a {
		color: inherit;
	}
	.reqs {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 1.5rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
		font-size: 0.92rem;
		color: var(--rn-silver);
	}
	.reqs li {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.reqs svg {
		width: 1.15rem;
		height: 1.15rem;
		fill: none;
		stroke: var(--rn-red-high);
		stroke-width: 1.8;
		stroke-linecap: round;
	}

	.caption {
		position: absolute;
		right: clamp(1rem, 3vw, 2.25rem);
		bottom: clamp(1rem, 2vw, 1.5rem);
		margin: 0;
		padding: 0.25rem 0.7rem;
		font-family: var(--rn-font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		color: var(--rn-silver);
		background: rgb(5 5 6 / 0.75);
		border: 1px solid rgb(230 232 236 / 0.25);
	}

	.motion-toggle {
		position: absolute;
		left: clamp(1rem, 3vw, 2.25rem);
		bottom: clamp(1rem, 2vw, 1.5rem);
		width: 44px;
		height: 44px;
		color: var(--rn-text);
		background: rgb(10 10 12 / 0.6);
		border: 1px solid rgb(230 232 236 / 0.3);
		border-radius: 50%;
		cursor: pointer;
	}
	.motion-toggle .ico-play,
	.hero.paused .motion-toggle .ico-pause {
		display: none;
	}
	.hero.paused .motion-toggle .ico-play {
		display: inline;
	}

	.trailer {
		width: min(100% - 2rem, 70rem);
		padding: 0;
		background: #000;
		border: 1px solid var(--rn-graphite);
	}
	.trailer::backdrop {
		background: rgb(0 0 0 / 0.8);
	}
	.trailer video {
		display: block;
		width: 100%;
	}
	.trailer .close {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		z-index: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.motion-toggle {
			display: none;
		}
	}
</style>

<script>
	const hero = document.querySelector<HTMLElement>('[data-hero]');
	if (hero) {
		const toggle = hero.querySelector<HTMLButtonElement>('[data-motion-toggle]');
		let video: HTMLVideoElement | null = null;
		let visible = true;
		const paused = () => hero.classList.contains('paused');
		const sync = () => {
			if (!video) return;
			if (visible && !paused() && !document.hidden) video.play().catch(() => {});
			else video.pause();
		};
		toggle?.addEventListener('click', () => {
			hero.classList.toggle('paused');
			const p = paused();
			toggle.setAttribute('aria-pressed', String(p));
			toggle.setAttribute('aria-label', p ? 'Play background video' : 'Pause background video');
			sync();
		});

		// The loop, only when it's welcome (PLAN §5.4 gating).
		const config = hero.dataset.video ? JSON.parse(hero.dataset.video) : null;
		const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
		const welcome =
			config &&
			!matchMedia('(prefers-reduced-motion: reduce)').matches &&
			!conn?.saveData &&
			!['slow-2g', '2g', '3g'].includes(conn?.effectiveType ?? '');
		if (welcome) {
			addEventListener('load', () => {
				video = document.createElement('video');
				Object.assign(video, { muted: true, loop: true, playsInline: true, autoplay: true, preload: 'none', poster: config.poster });
				video.setAttribute('aria-hidden', 'true');
				for (const s of config.sources) {
					const source = document.createElement('source');
					source.src = s.src;
					source.type = s.type;
					if (s.media) source.media = s.media;
					video.append(source);
				}
				hero.querySelector('.backdrop')!.prepend(video);
				new IntersectionObserver(([e]) => {
					visible = e.isIntersecting;
					sync();
				}).observe(hero);
				document.addEventListener('visibilitychange', sync);
				sync();
			});
		}

		// The trailer, loaded on demand (D5).
		const dialog = hero.querySelector<HTMLDialogElement>('[data-trailer]');
		hero.querySelector('[data-trailer-open]')?.addEventListener('click', () => {
			if (!dialog) return;
			const v = dialog.querySelector('video')!;
			if (!v.src) {
				v.src = v.dataset.src!;
			}
			dialog.showModal();
			v.play().catch(() => {});
		});
		dialog?.addEventListener('close', () => dialog.querySelector('video')!.pause());
	}
</script>
